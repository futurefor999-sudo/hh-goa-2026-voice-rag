# --- Speech-to-text (pick Sarvam; task requires Sarvam or ElevenLabs) ---
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
# Sarvam STT model — see https://docs.sarvam.ai for current model names
SARVAM_STT_MODEL=saarika:v2

# --- Answer generation backend (pick one) ---
GEN_PROVIDER=anthropic          # "anthropic" | "openai" | "mock"
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings backend for retrieval ---
EMBEDDING_PROVIDER=tfidf        # "tfidf" (offline, default) | "sentence-transformers"
SENTENCE_TRANSFORMERS_MODEL=intfloat/multilingual-e5-base

# --- Retrieval / chunking knobs ---
TOP_K=5
CHUNK_STRATEGY=hybrid           # "fixed" | "semantic" | "hybrid"
FIXED_CHUNK_SIZE=250
FIXED_CHUNK_OVERLAP=50

# --- Guardrails ---
GROUNDING_MIN_OVERLAP=0.12      # min lexical overlap between answer and context before we trust it
# NOTE on this default: TF-IDF similarity scores are corpus-size- and
# vocabulary-dependent, so this floor should be re-tuned once you're on
# the real MSMARCO-XI corpus (millions of passages behave very
# differently from the 5-doc sample) or on sentence-transformer
# embeddings (whose similarity scale differs from TF-IDF's). 0.18 was
# tuned against the bundled sample corpus — see scripts/demo_cases.py.
OFFTOPIC_MIN_SIM=0.18

# --- Server ---
HOST=0.0.0.0
PORT=8000
